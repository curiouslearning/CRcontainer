<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifest overlay for the offline standalone flavors (mwfCongo, mwfAngola), wired in through
  `manifest.srcFile` in app/build.gradle. Merged on top of the main manifest for those flavors only.

  Sentry is switched off for these builds: the main manifest's io.sentry.dsn would make the SDK
  auto-initialise from its ContentProvider on process start, so the DSN is removed and auto-init
  disabled here, and MyApplication skips its manual SentryAndroid.init() when
  BuildConfig.OFFLINE_STANDALONE is set. The remaining Sentry.* calls in the code are no-ops on an
  uninitialised SDK. The online (Play Store) flavor is unaffected.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <meta-data
            android:name="io.sentry.dsn"
            tools:node="remove" />
        <meta-data
            android:name="io.sentry.auto-init"
            android:value="false" />
    </application>

</manifest>
